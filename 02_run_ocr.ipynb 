        "        \"carts\",\n",
        "        \"limited_rooms\",\n",
        "        \"we_have\",\n",
        "        \"best_selling\"\n",
        "    ]\n",
        "\n",
        "    # Visual misdirection signals\n",
        "    visual_misdirection_terms = [\n",
        "        \"visual_misdirection\",\n",
        "        \"misdirection\",\n",
        "        \"discount\",\n",
        "        \"sale_visual_emphasis\",\n",
