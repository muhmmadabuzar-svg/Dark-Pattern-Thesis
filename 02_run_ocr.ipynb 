        "    ]\n",
        "\n",
        "    # Fake urgency signals\n",
        "    fake_urgency_terms = [\n",
        "        \"limited_time\",\n",
        "        \"limited_time_deal\",\n",
        "        \"only\",\n",
        "        \"left\",\n",
        "        \"low_stock\",\n",
        "        \"selling_fast\",\n",
        "        \"ends\",\n",
