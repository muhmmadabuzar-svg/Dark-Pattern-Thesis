        "def extract_website(filename):\n",
        "    \"\"\"\n",
        "    Extracts website name from filename.\n",
        "    Example:\n",
        "    AMAZON_001_crop_limited_time_deal_fake_urgency_ocr.png\n",
        "    returns AMAZON\n",
        "    \"\"\"\n",
        "    return filename.split(\"_\")[0]\n",
        "\n",
        "\n",
        "def extract_expected_category(filename):\n",
        "    \"\"\"\n",
        "    Extracts expected dark pattern category from filename.\n",
        "    This depends on your filename containing category words.\n",
        "    \"\"\"\n",
        "    name = filename.lower()\n",
        "\n",
        "    if \"fake_urgency\" in name or \"urgency\" in name:\n",
        "        return \"candidate_fake_urgency\"\n",
        "    elif \"visual_misdirection\" in name or \"misdirection\" in name:\n",
        "        return \"candidate_visual_misdirection\"\n",
        "    elif \"obstruction\" in name or \"popup\" in name:\n",
        "        return \"candidate_obstruction\"\n",
        "    else:\n",
        "        return \"unknown\"\n",
        "\n",
        "\n",
        "def clean_ocr_text(text):\n",
        "    \"\"\"\n",
        "    Cleans OCR output slightly while keeping original meaning.\n",
        "    \"\"\"\n",
        "    text = text.replace(\"\\n\", \" \")\n",
        "    text = re.sub(r\"\\s+\", \" \", text)\n",
        "    return text.strip()\n",
        "\n",
        "\n",
        "def preprocess_for_ocr(image_path):\n",
        "    \"\"\"\n",
        "    Basic preprocessing for cropped e-commerce screenshot regions.\n",
        "    Steps:\n",
        "    1. Read image\n",
        "    2. Convert to grayscale\n",
        "    3. Resize image to improve OCR readability\n",
        "    4. Apply thresholding\n",
        "    \"\"\"\n",
        "    image = cv2.imread(image_path)\n",
        "\n",
        "    if image is None:\n",
        "        return None\n",
        "\n",
        "    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)\n",
        "\n",
        "    # Resize to help Tesseract read small text\n",
        "    scale_percent = 200\n",
        "    width = int(gray.shape[1] * scale_percent / 100)\n",
        "    height = int(gray.shape[0] * scale_percent / 100)\n",
        "    resized = cv2.resize(gray, (width, height), interpolation=cv2.INTER_CUBIC)\n",
        "\n",
        "    # Thresholding\n",
        "    processed = cv2.threshold(\n",
        "        resized, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU\n",
        "    )[1]\n",
        "\n",
        "    return processed"
      ],
      "metadata": {
        "id": "6_ZKJWWR-YYP"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "ocr_results = []\n",
        "\n",
        "tesseract_config = \"--psm 6\"\n",
        "\n",
        "for idx, filename in enumerate(image_files, start=1):\n",
        "    image_path = os.path.join(crop_folder, filename)\n",
        "\n",
        "    processed_image = preprocess_for_ocr(image_path)\n",
        "\n",
        "    if processed_image is None:\n",
        "        raw_text = \"\"\n",
        "        clean_text = \"\"\n",
        "        status = \"image_read_failed\"\n",
        "    else:\n",
        "        raw_text = pytesseract.image_to_string(\n",
        "            processed_image,\n",
        "            config=tesseract_config\n",
        "        )\n",
        "\n",
        "        clean_text = clean_ocr_text(raw_text)\n",
        "        status = \"processed\"\n",
        "\n",
        "    ocr_results.append({\n",
        "        \"image_id\": idx,\n",
        "        \"filename\": filename,\n",
        "        \"website\": extract_website(filename),\n",
        "        \"expected_category\": extract_expected_category(filename),\n",
        "        \"ocr_text_raw\": raw_text,\n",
        "        \"ocr_text_clean\": clean_text,\n",
        "        \"ocr_status\": status,\n",
        "        \"character_count\": len(clean_text),\n",
        "        \"word_count\": len(clean_text.split()) if clean_text else 0,\n",
        "        \"preprocessing_method\": \"grayscale_resize_200_otsu_threshold\",\n",
        "        \"tesseract_config\": tesseract_config,\n",
        "        \"ocr_quality\": \"\",\n",
        "        \"notes\": \"\"\n",
        "    })\n",
        "\n",
        "ocr_df = pd.DataFrame(ocr_results)\n",
        "\n",
        "ocr_df.head()"
