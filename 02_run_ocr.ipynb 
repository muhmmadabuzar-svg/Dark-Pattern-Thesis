        "        \"percent_off\",\n",
        "        \"30_percent_off\",\n",
        "        \"deals_spotlight\",\n",
        "        \"coupon\"\n",
        "    ]\n",
        "\n",
        "    if any(term in name for term in obstruction_terms):\n",
        "        return \"candidate_obstruction\"\n",
