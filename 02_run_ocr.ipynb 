        "def extract_expected_category(filename):\n",
        "    \"\"\"\n",
        "    Estimates the expected candidate dark pattern category from filename.\n",
        "    This is based on signal words in the cropped image filename.\n",
        "    \"\"\"\n",
        "    name = filename.lower()\n",
        "\n",
        "    # Obstruction signals\n",
        "    obstruction_terms = [\n",
        "        \"obstruction\",\n",
        "        \"popup\",\n",
        "        \"pop_up\",\n",
